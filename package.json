{
  "name": "runanything-cli",
  "version": "0.1.0",
  "description": "One command to discover and run your project's tasks.",
  "type": "module",
  "author": "Adam Volkman <volkman.adam@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itIsMaku/runa.git"
  },
  "homepage": "https://github.com/itIsMaku/runa#readme",
  "bugs": {
    "url": "https://github.com/itIsMaku/runa/issues"
  },
  "keywords": [
    "cli",
    "runner",
    "tasks",
    "project",
    "cross-platform"
  ],
  "bin": {
    "runa": "dist/bin.js",
    "runany": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test",
    "prepare": "npm run build",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:package": "node scripts/verify-package.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
